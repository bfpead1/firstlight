# Copy this file to .env and fill in the values.

PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client.
# In dev this goes through the Vite proxy so the login cookie lands on the frontend's origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# ── Optional ────────────────────────────────────────────────────────────────

# ── AI (OpenAI-compatible providers) ─────────────────────────────────────────
# Server-side only: never put these in frontend code. Each task lists "provider:model" pairs,
# comma-separated; the first is used, the rest are fallbacks on 429/5xx errors. Model ids are
# checked against each provider's live model list at startup. Leave a task blank to turn it off.

# Groq (https://console.groq.com/keys). Turn on Zero Data Retention under Settings > Data Controls.
GROQ_API_KEY=
GROQ_REASONING_EFFORT=low
# Per-model limits from Groq console > Settings > Limits. The client waits instead of exceeding them.
LLM_GROQ_TPM=8000
LLM_GROQ_RPM=30

# Cloudflare Workers AI (fallback). Skipped cleanly until both are set.
# Account id: dashboard sidebar. Token: My Profile > API Tokens, with "Workers AI: Read" and "Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Any other OpenAI-compatible provider, no code changes:
#   LLM_PROVIDER_<NAME>_BASE_URL=https://.../v1   LLM_PROVIDER_<NAME>_API_KEY=...
#   optional: LLM_PROVIDER_<NAME>_TPM, _RPM, _JSON_MODE=schema|object
# then use "<name>:<model>" in the routes below.

# Routes per task.
LLM_TRIAGE_MODELS=groq:openai/gpt-oss-20b,cloudflare:@cf/openai/gpt-oss-120b
LLM_EXTRACT_MODELS=groq:qwen/qwen3.8-27b,cloudflare:@cf/openai/gpt-oss-120b
LLM_PLAN_MODELS=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b
LLM_WORKOUT_MODELS=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b

# Timezone for "today" and the morning job, and the local time (24h) the daily plan is generated.
APP_TIMEZONE=America/Denver
PLAN_JOB_TIME=05:30

# When both are set, data is stored in Supabase instead of backend/data/db.json.
# Supabase dashboard > Project Settings > API. Use the service_role key (server only, never in the frontend).
# Run the files in supabase/migrations/ in order (0001 through 0004) in the SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails allowed to sign in. Blank lets any Google account in
# (development only: the server refuses to start in production without it).
ALLOWED_EMAILS=
